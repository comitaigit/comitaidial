// Prisma schema for Comitai's auth/security domain.
// See ../../.claude/skills/backend-conventions/SKILL.md for the rules this maps to.

generator client {
  provider = "prisma-client-js"
  // No custom `output`: this generates into node_modules/@prisma/client,
  // which the Nest watcher never needs to copy into dist/ (unlike a
  // src/-relative output, whose non-.ts artifacts — .wasm, engine binaries —
  // tsc's watch mode doesn't track, breaking `nest start --watch`).
}

datasource db {
  provider = "postgresql"
}

// --- Multi-tenancy ---
// Every domain table below is scoped to a Tenant from its first migration —
// see the Dial spec (founder, 2026-08-24). RefreshToken/LoginEvent are
// deliberately NOT given their own tenantId: they're pure auth plumbing,
// always looked up by tokenHash or userId (never listed per-tenant), and
// userId already transitively scopes them — a duplicate column there would
// be dead weight, not a real isolation boundary.
model Tenant {
  id   String @id @default(uuid())
  name String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                  User[]
  accounts               Account[]
  people                 Person[]
  cadences               Cadence[]
  cadenceSteps           CadenceStep[]
  cadenceEnrollments     CadenceEnrollment[]
  calls                  Call[]
  signals                Signal[]
  activities             Activity[]
  tasks                  Task[]
  accountResearch        AccountResearch[]
  goals                  Goal[]
  clientCompanies        ClientCompany[]
  dialBatches            DialBatch[]
  prospectEvents         ProspectEvent[]
  stepExecutions         StepExecution[]
  actions                Action[]
  googleAccounts         GoogleAccount[]
  enrichmentJobs         EnrichmentJob[]
  prospectingJobs        ProspectingJob[]
  assistantConversations AssistantConversation[]
  assistantProposals     AssistantProposal[]

  /// Pay-per-result balance for Data Enrichment (see EnrichmentService) —
  /// debited only when a provider call actually fills a gap, never on a
  /// miss or error. No billing/checkout exists yet; an ADMIN tops this up
  /// via POST /v1/enrichment/credits/grant until one does.
  enrichmentCreditBalance Int @default(0)

  @@map("tenants")
}

enum Role {
  ADMIN
  MEMBER
}

model User {
  id String @id @default(uuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// Globally unique for now (single-tenant user base in practice — no
  /// tenant signup/invite flow exists yet). Revisit if/when a person needs
  /// logins in two different tenants under the same email.
  email String @unique
  name  String

  /// Argon2id hash — never the plaintext password.
  passwordHash String

  role Role @default(MEMBER)

  emailVerifiedAt DateTime?

  /// Account lockout (brute-force mitigation), tracked in-DB so it survives
  /// across instances instead of an in-memory counter.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  createdAt DateTime @default(now()) @updatedAt
  updatedAt DateTime @updatedAt

  refreshTokens          RefreshToken[]
  loginEvents            LoginEvent[]
  activities             Activity[]
  calls                  Call[]
  goals                  Goal[]
  dialBatches            DialBatch[]
  cadenceEnrollments     CadenceEnrollment[]
  googleAccount          GoogleAccount?
  assistantConversations AssistantConversation[]
  assistantProposals     AssistantProposal[]

  @@index([tenantId])
  @@map("users")
}

model RefreshToken {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// SHA-256 hash of the refresh token — the raw token is only ever sent to
  /// the client in the httpOnly cookie, never stored.
  tokenHash String @unique

  /// Rotation chain: each refresh issues a new token and revokes this one,
  /// pointing forward so reuse of a revoked token is detectable (token-theft
  /// detection) and the whole chain can be revoked.
  replacedByTokenHash String?

  userAgent String?
  ipAddress String?

  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

enum LoginEventType {
  LOGIN_SUCCESS
  LOGIN_FAILURE
  LOGOUT
  TOKEN_REUSE_DETECTED
  ACCOUNT_LOCKED
}

model LoginEvent {
  id     String  @id @default(uuid())
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// Kept even when the user lookup fails (e.g. unknown email) for
  /// brute-force / credential-stuffing monitoring.
  email String?

  type      LoginEventType
  ipAddress String?
  userAgent String?
  reason    String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([email])
  @@map("login_events")
}

// --- Domain: Accounts, Prospects, Cadences, Activities, Calls, Signals ---
// See ../../.claude/skills/business-rules-authoring/SKILL.md for the source
// business rules these fields encode (pain from transcript, manual priority/
// influence, the 30s conversation rule, the parallel-dial tie-break rule).

enum AccountPriority {
  HIGH
  MEDIUM
  LOW
}

model Account {
  id String @id @default(uuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name    String
  /// Unique per tenant, not globally — two unrelated Comitai customers can
  /// both be prospecting the same real-world company.
  domain  String?
  segment String?

  /// Manual, set by the rep — HIGH/MEDIUM/LOW ("alta"/"média"/"baixa").
  priority AccountPriority?

  /// Free text extracted from call transcripts by the AI pipeline (not yet
  /// wired up). Null means "não mapeada" — never inferred without enough
  /// transcript data, per the founder's rule captured 2026-08-21.
  pain String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  people          Person[]
  signals         Signal[]
  activities      Activity[]
  tasks           Task[]
  research        AccountResearch[]
  prospectEvents  ProspectEvent[]
  enrichmentJobs  EnrichmentJob[]
  prospectingJobs ProspectingJob[]

  @@unique([tenantId, domain])
  @@index([tenantId])
  @@map("accounts")
}

enum InfluenceLevel {
  FINANCIAL_DECISION_MAKER
  DIRECT_INFLUENCER
  OPERATIONAL_DECISION_MAKER
  INDIRECT_INFLUENCER
}

model Person {
  id String @id @default(uuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  name String
  role String?

  email       String?
  phone       String?
  linkedinUrl String?

  /// Manual, set by the rep — decisor financeiro / influenciador direto /
  /// decisor operacional / influenciador indireto.
  influenceLevel InfluenceLevel?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cadenceEnrollments CadenceEnrollment[]
  calls              Call[]
  activities         Activity[]
  signals            Signal[]
  tasks              Task[]
  prospectEvents     ProspectEvent[]
  actions            Action[]
  enrichmentJobs     EnrichmentJob[]
  prospectingJobs    ProspectingJob[]

  @@index([tenantId])
  @@index([accountId])
  @@map("people")
}

enum CadenceStepType {
  CALL
  AUTOMATIC_EMAIL
  MANUAL_EMAIL
  MANUAL_SMS
  WHATSAPP_MESSAGE
  ACTION_ITEM
  LINKEDIN_CONNECTION_REQUEST
  LINKEDIN_MESSAGE
}

/// The company/product a cadence is prospecting on behalf of — Comitai runs
/// outbound for multiple client companies, and the AI research/battlecards
/// need to speak to whichever one a given cadence represents, not always
/// Comitai's own positioning. A cadence with no clientCompanyId is
/// "incomplete": the Dialer refuses to start dialing it until this is set,
/// per the founder's 2026-08-25 decision — no silent fallback to a default.
model ClientCompany {
  id String @id @default(uuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name        String
  mainProduct String

  /// Free text — differentiators, positioning, whatever helps the LLM write
  /// a sharper battlecard. Optional; the prompt works with just name+product.
  positioning String?

  /// Job titles/role keywords that count as ICP fit for this product (e.g.
  /// ["Diretor Comercial", "VP Sales"]) — the basic ICP question AI
  /// Prospecting requires an answer to before it spends a provider credit
  /// searching for a contact (founder's rule, 2026-09). Empty means
  /// prospecting isn't configured yet for this ClientCompany.
  targetRoles String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cadences        Cadence[]
  accountResearch AccountResearch[]
  prospectingJobs ProspectingJob[]

  @@index([tenantId])
  @@map("client_companies")
}

model Cadence {
  id String @id @default(uuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name   String
  active Boolean @default(true)

  /// Nullable — see ClientCompany's doc comment. SetNull (not Cascade) on
  /// delete: losing the client company record shouldn't destroy the
  /// cadence, just knock it back to "incomplete".
  clientCompanyId String?
  clientCompany   ClientCompany? @relation(fields: [clientCompanyId], references: [id], onDelete: SetNull)

  /// Governs whether an AI-generated Action (email/LinkedIn content) from
  /// this cadence's steps waits for a BDR to approve before it's dispatched
  /// (MANUAL, the default — same "ask until you trust it" posture as a
  /// fresh permission mode) or fires as soon as the engine decides it's
  /// ready (FULL). Only gates AI-authored content — deterministic steps
  /// like dialing are never held up by this.
  approvalMode ApprovalMode @default(MANUAL)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  steps       CadenceStep[]
  enrollments CadenceEnrollment[]
  dialBatches DialBatch[]

  @@index([tenantId])
  @@index([clientCompanyId])
  @@map("cadences")
}

enum ApprovalMode {
  MANUAL
  FULL
}

model CadenceStep {
  id String @id @default(uuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  cadenceId String
  cadence   Cadence @relation(fields: [cadenceId], references: [id], onDelete: Cascade)

  /// Position within the cadence — steps execute in this order, not by day
  /// offset alone (two steps can share a day offset).
  order     Int
  dayOffset Int
  type      CadenceStepType

  /// LinkedIn-only gating: don't advance to the next step until the
  /// connection request is accepted (mirrors the Nooks-style builder).
  waitForConnectionAccepted Boolean @default(false)

  notes String?

  /// Trigger/action config for the Play Engine — shape depends on `type`.
  /// e.g. { "afterDays": 3 } or { "onEvent": "linkedin.connection.accepted" }
  /// for triggerConfig; { "generateWithAI": true, "prompt": "..." } for
  /// actionConfig. Kept as Json rather than dedicated columns/tables
  /// deliberately — the shape is expected to grow with real Plays before
  /// it's worth normalizing (2026-09-08).
  triggerConfig Json?
  actionConfig  Json?

  stepExecutions StepExecution[]

  @@unique([cadenceId, order])
  @@index([tenantId])
  @@index([cadenceId])
  @@map("cadence_steps")
}

model CadenceEnrollment {
  id String @id @default(uuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  cadenceId String
  cadence   Cadence @relation(fields: [cadenceId], references: [id], onDelete: Cascade)

  personId String
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  /// The BDR who enrolled this person — doubles as whose connected Gmail
  /// account the Play Engine sends AI Email actions from for this
  /// enrollment (see GmailService), since neither Account nor Cadence has
  /// its own concept of an assigned owner. Nullable because it's new on an
  /// additive migration — pre-existing enrollments have no value here, and
  /// an AI Email action for one of them just fails with "no sender" rather
  /// than guessing an owner.
  enrolledById String?
  enrolledBy   User?   @relation(fields: [enrolledById], references: [id], onDelete: SetNull)

  currentStepOrder Int     @default(0)
  active           Boolean @default(true)

  /// Manual position in the Dialer queue for this cadence, set by dragging
  /// a row — null means "not manually placed yet", falls back to the
  /// priority-based default order. Once any row in a cadence is dragged,
  /// the whole cadence's queue is re-numbered so order is unambiguous.
  queuePosition Int?

  enrolledAt DateTime @default(now())

  stepExecutions StepExecution[]

  @@unique([cadenceId, personId])
  @@index([tenantId])
  @@index([personId])
  @@map("cadence_enrollments")
}

// --- Play Engine ---
// Generalizes the outcome→signal→next-action pattern the Dialer already
// does in miniature (a call outcome writes a Signal + sometimes a Task) into
// something CadenceStep can actually execute against, instead of just being
// a template a human reads. See docs discussion 2026-09-08: the engine only
// ever makes deterministic decisions (did the deadline pass? did the
// expected event arrive?) — an AI-authored Action's *content* can come from
// a prompt, but whether/when it fires never does.

/// "Something happened" — the single source of truth the Play Engine polls
/// for unprocessed rows to react to. Deliberately separate from Activity
/// (the audit trail of what a human/system *did*) — this is what the
/// outside world (or another part of the system) *told us happened*: an
/// email was opened, a LinkedIn invite was accepted, a call was classified.
model ProspectEvent {
  id String @id @default(uuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// e.g. "email.sent", "email.bounced", "linkedin.connection.accepted",
  /// "call.outcome_recorded" — free string, not an enum: the vocabulary of
  /// event types is expected to grow with each new Action type without a
  /// migration each time.
  eventType String

  personId String?
  person   Person? @relation(fields: [personId], references: [id], onDelete: Cascade)

  accountId String?
  account   Account? @relation(fields: [accountId], references: [id], onDelete: Cascade)

  /// Where this event came from — "dialer" | "email_provider" |
  /// "linkedin_extension" | "enrichment" | ... — lets a StepExecution's
  /// waitingForEvent match against provenance, not just event type, if two
  /// sources ever emit the same type.
  source   String
  metadata Json

  /// Null = not yet consumed by the Play Engine's poll loop. Set once a
  /// StepExecution has acted on it, so the same event never advances two
  /// executions or gets double-processed on a retried poll.
  processedAt DateTime?

  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([tenantId, processedAt])
  @@index([personId])
  @@index([accountId])
  @@map("prospect_events")
}

enum StepExecutionStatus {
  /// Waiting on triggerConfig.afterDays — becomes READY once scheduledFor
  /// passes.
  PENDING
  /// Waiting on triggerConfig.onEvent — becomes READY once a matching
  /// ProspectEvent is found.
  WAITING_EVENT
  /// Due to run; picked up by the next poll.
  READY
  /// Claimed by a poll iteration, action dispatch in flight.
  EXECUTING
  DONE
  FAILED
  /// Condition evaluated false with no retry path (e.g. lost the
  /// discovery-of-manager branch) — distinct from FAILED, which means the
  /// action itself errored.
  SKIPPED
}

/// One row per (enrollment, step) the engine has ever considered — this is
/// what actually makes a CadenceStep template run instead of just being a
/// form a human fills in. The unique constraint is the engine's
/// idempotency guarantee: a poll that finds the same enrollment+step twice
/// (retry, duplicate tick) can never create a second execution for it.
model StepExecution {
  id String @id @default(uuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  enrollmentId String
  enrollment   CadenceEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  cadenceStepId String
  cadenceStep   CadenceStep @relation(fields: [cadenceStepId], references: [id], onDelete: Cascade)

  status StepExecutionStatus @default(PENDING)

  /// Resolved absolute time once triggerConfig.afterDays is known relative
  /// to the previous step's completion — null for event-gated steps.
  scheduledFor DateTime?

  /// The ProspectEvent.eventType this execution is blocked on, when
  /// status = WAITING_EVENT. Null otherwise.
  waitingForEvent String?

  executedAt DateTime?
  /// Free-form result of the step once DONE/FAILED/SKIPPED — e.g. which
  /// Action it produced, or why it was skipped.
  outcome    Json?

  createdAt DateTime @default(now())

  actions Action[]

  @@unique([enrollmentId, cadenceStepId])
  @@index([tenantId, status, scheduledFor])
  @@map("step_executions")
}

enum ActionType {
  SEND_EMAIL
  LINKEDIN_CONNECT
  LINKEDIN_MESSAGE
  ENRICH
}

enum ActionStatus {
  /// Ready to dispatch — will be picked up immediately (Cadence.approvalMode
  /// = FULL, or this Action type isn't AI-authored content).
  PENDING
  /// Cadence.approvalMode = MANUAL and this Action carries AI-generated
  /// content — sits here until a BDR approves (or edits-then-approves) it
  /// in the approvals queue. Never auto-advances out of this state.
  PENDING_APPROVAL
  SENT
  FAILED
  CANCELLED
}

/// A concrete, dispatchable action — the thing that actually leaves the
/// system (an email, a LinkedIn action) or calls a paid provider (enrich).
/// idempotencyKey is what makes a retried dispatch safe: the Action
/// Dispatcher upserts on this key, never creates a second row for the same
/// logical action.
model Action {
  id String @id @default(uuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  type ActionType

  personId String
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  /// Null for an Action created outside the Play Engine (kept nullable
  /// rather than required so this table can be reused later by something
  /// that isn't step-driven, without a schema change).
  stepExecutionId String?
  stepExecution   StepExecution? @relation(fields: [stepExecutionId], references: [id], onDelete: SetNull)

  status ActionStatus @default(PENDING)

  /// Shape depends on `type` — e.g. { subject, body } for SEND_EMAIL,
  /// { note } for LINKEDIN_CONNECT.
  payload Json

  idempotencyKey String @unique

  attempts Int @default(0)

  createdAt  DateTime  @default(now())
  executedAt DateTime?

  @@index([tenantId, status])
  @@map("actions")
}

// --- AI Email ---
// Each BDR connects their own Gmail account (OAuth2, offline access) so AI
// Email actions send as them, not from a shared/transactional address — see
// build-order item 3 (2026-09-08). One BDR, one Gmail account: reconnecting
// overwrites the previous credential rather than allowing several.
model GoogleAccount {
  id String @id @default(uuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The connected Gmail address — shown in the UI so the BDR can confirm
  /// which account they authorized, and used as the visible sender.
  email String

  /// AES-256-GCM ciphertext (iv + authTag + ciphertext, base64), encrypted
  /// with TOKEN_ENCRYPTION_KEY — see GmailService.encrypt/decrypt. Unlike
  /// the JWT refresh-token hash elsewhere in this schema, this must be
  /// reversible: GmailService exchanges it for a fresh access token on
  /// every send, it's never compared against an incoming value.
  encryptedRefreshToken String

  /// Space-separated OAuth scopes actually granted, as Google returned
  /// them — lets a future scope expansion detect who needs to reconnect.
  scope String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@map("google_accounts")
}

// --- Data Enrichment ---
// Pay-per-result billing (adopted from evaluating TexAu's model, 2026-09):
// a provider call that comes back empty or errors costs the tenant nothing
// — only a call that actually fills a data gap debits enrichmentCreditBalance.
// One job per provider call, kept as an audit trail rather than only a
// running balance, so "why did our credits drop" is always answerable.

enum EnrichmentProviderName {
  LUSHA
}

enum EnrichmentJobStatus {
  /// Provider returned at least one field this record didn't already have.
  SUCCESS
  /// Provider call succeeded but had nothing new to add.
  NO_MATCH
  /// Provider call itself failed (network, auth, rate limit, ...).
  FAILED
}

model EnrichmentJob {
  id String @id @default(uuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// Exactly one of personId/accountId is set — a job enriches either a
  /// contact (email/phone) or a company (domain/segment), never both.
  personId String?
  person   Person? @relation(fields: [personId], references: [id], onDelete: Cascade)

  accountId String?
  account   Account? @relation(fields: [accountId], references: [id], onDelete: Cascade)

  provider EnrichmentProviderName
  status   EnrichmentJobStatus

  /// 0 unless status = SUCCESS — see the pay-per-result note above.
  creditsCharged Int @default(0)

  /// Which fields were actually filled (e.g. ["email", "phone"]) — empty
  /// for NO_MATCH/FAILED. Kept as Json rather than a join table since it's
  /// display/audit-only, never queried by field name.
  fieldsFilled Json?

  errorMessage String?

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([personId])
  @@index([accountId])
  @@map("enrichment_jobs")
}

// --- AI Prospecting (variant A: find the right contact at a known Account) ---
// Searches a provider for a person matching ClientCompany.targetRoles at an
// Account that already exists in Comitai — this is the "who's the right
// buyer here" step, distinct from EnrichmentJob (which fills gaps on a
// contact/company we already have). Shares the same credit pool
// (Tenant.enrichmentCreditBalance) and pay-per-result policy: a search
// that finds nobody or errors costs nothing.
model ProspectingJob {
  id String @id @default(uuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  clientCompanyId String
  clientCompany   ClientCompany @relation(fields: [clientCompanyId], references: [id], onDelete: Cascade)

  provider EnrichmentProviderName
  status   EnrichmentJobStatus

  /// 0 unless status = SUCCESS.
  creditsCharged Int @default(0)

  /// The Person created from this search, when status = SUCCESS. Nullable
  /// (not required) so the row survives if that Person is later deleted.
  personId String?
  person   Person? @relation(fields: [personId], references: [id], onDelete: SetNull)

  errorMessage String?

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([accountId])
  @@map("prospecting_jobs")
}

// --- Assistente ---
// A conversational, per-BDR assistant over Claude's native tool use.
// Messages are stored as raw Anthropic content blocks (not just text) so a
// tool_use/tool_result pair can be replayed verbatim on the next turn —
// the Claude API's multi-turn tool-use contract requires the exact block
// structure, not a re-derived summary. Item 6 (2026-09) ships only
// auto-executing read-only tools; item 7 adds proposal tools, which never
// auto-execute regardless of the cadence's ApprovalMode — same principle,
// applied to a human chatting instead of a Play running unattended.
model AssistantConversation {
  id String @id @default(uuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// First user message, truncated — set once, shown in a conversation
  /// list. Null until that first message is sent.
  title String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages  AssistantMessage[]
  proposals AssistantProposal[]

  @@index([tenantId])
  @@index([userId])
  @@map("assistant_conversations")
}

enum AssistantMessageRole {
  USER
  ASSISTANT
}

model AssistantMessage {
  id String @id @default(uuid())

  conversationId String
  conversation   AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  role AssistantMessageRole

  /// Anthropic.MessageParam['content'] verbatim — a string for a plain
  /// user message, or the full content-block array (text/tool_use/
  /// tool_result) for anything tool-use touched.
  content Json

  createdAt DateTime @default(now())

  @@index([conversationId])
  @@map("assistant_messages")
}

// Item 7: proposal tools. Deliberately its own table rather than reusing
// the Play Engine's Action — Action is step-execution-driven and dispatched
// unattended by the poll loop; a proposal is chat-initiated and always
// waits on an explicit human click, regardless of any cadence's
// ApprovalMode (that setting only ever governed unattended Play Engine
// actions, never a human conversation). Execution happens synchronously at
// approval time, not via a dispatcher, so there's no separate
// "approved but not yet executed" state.
enum AssistantProposalType {
  ENROLL_IN_CADENCE
  SEND_EMAIL
  ENRICH_PERSON
}

enum AssistantProposalStatus {
  PENDING
  REJECTED
  EXECUTED
  FAILED
}

model AssistantProposal {
  id String @id @default(uuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  conversationId String
  conversation   AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type   AssistantProposalType
  status AssistantProposalStatus @default(PENDING)

  /// Tool-specific input the model proposed — e.g. {personId, cadenceId}
  /// or {personId, subject, body}. Re-validated at approval time (never
  /// trusted as-is), since a human can take minutes or hours to confirm.
  payload Json

  /// Set once resolved: the created enrollment/job id on EXECUTED, or an
  /// error message on FAILED. Null while PENDING/REJECTED.
  result Json?

  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([tenantId])
  @@index([conversationId])
  @@map("assistant_proposals")
}

// Per the Dial spec (founder, 2026-08-24) — replaces the previous outcome
// set entirely. "Não atendeu" is the standardized label everywhere in the
// product (was "Só chamou").
enum CallOutcome {
  VOICEMAIL
  WRONG_PERSON
  BUSY
  NO_ANSWER
  INVALID_NUMBER
  CALLBACK_REQUESTED
  MEETING_SCHEDULED
  NOT_INTERESTED
}

// Sub-reason captured only when outcome = NOT_INTERESTED.
enum NotInterestedReason {
  BUDGET
  NOT_INTERESTED
  PRODUCT_FEEDBACK
  USES_COMPETITOR
  DOES_NOT_WANT_TO_TALK
}

// One dial batch = up to 3 prospects dialed simultaneously from one click of
// "Iniciar discagem" (2026-08-25, v1 fixed at 3 lines — not yet configurable
// per tenant). winnerCallSid is the compare-and-swap field that decides the
// AMD race: whichever leg's async AMD callback first UPDATEs this row from
// null wins and gets bridged to the BDR's conference; every other leg that
// tries after that finds it already set and hangs up instead.
model DialBatch {
  id String @id @default(uuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  cadenceId String
  cadence   Cadence @relation(fields: [cadenceId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Twilio Conference room name (e.g. "batch-<id>") — the BDR's browser
  /// leg and whichever outbound leg wins the race both join this room.
  conferenceName String @unique

  /// Set via compare-and-swap once a leg's AMD callback confirms a human —
  /// null means no winner yet (or every leg lost: machine/no-answer/busy).
  winnerCallSid String?

  createdAt DateTime @default(now())

  calls Call[]

  @@index([tenantId])
  @@index([cadenceId])
  @@map("dial_batches")
}

enum ParallelLegStatus {
  RINGING
  MACHINE_DETECTED
  NO_ANSWER
  BUSY
  FAILED
  CONNECTED
  ABANDONED
}

model Call {
  id String @id @default(uuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// Nullable — a call isn't always tied to a known prospect yet (e.g. a
  /// Twilio credential/caller-ID verification call placed via /calls/test).
  personId String?
  person   Person? @relation(fields: [personId], references: [id], onDelete: SetNull)

  /// Denormalized — which rep placed the call, for Call Check's "User name"
  /// column. Set at creation time; the Activity trail also records userId,
  /// but joining through Activity for a simple list column isn't worth it.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// Null for calls placed outside Twilio (e.g. manual log) — set once the
  /// real dialer module wires this up via the Twilio Calls API.
  twilioCallSid String? @unique

  toNumber   String
  fromNumber String

  outcome CallOutcome?

  /// Set only when outcome = NOT_INTERESTED.
  notInterestedReason NotInterestedReason?

  durationSeconds Int?

  /// True only when durationSeconds >= 30 — the "real conversation" rule.
  /// Computed server-side on call completion, never settable by the outcome
  /// picker in the UI (a BDR can't override it by picking a different
  /// outcome button).
  isConversation Boolean @default(false)

  connectedAt DateTime?
  endedAt     DateTime?
  createdAt   DateTime  @default(now())

  /// Twilio's recording URL, set once <Dial record="..."> finishes and the
  /// recordingStatusCallback webhook fires. Base URL only (no .mp3/.wav
  /// suffix) — Twilio recordings require Twilio Basic Auth to download, so
  /// this is never handed to the frontend directly.
  recordingUrl String?

  /// Array of { speaker: number; text: string; start: number; end: number }
  /// utterances from Deepgram diarization, set once transcription
  /// completes. Null until then — Call Check's AI Sales Coach feedback
  /// (>= 1 min calls) reads this.
  transcript Json?

  /// { context: string; positives: string[]; improvements: string[] } —
  /// generated once transcript is present AND durationSeconds >= 60 (Call
  /// Check's AI Sales Coach). Calls under a minute never get one, per the
  /// Dial spec — null forever for those, not just "not yet".
  aiFeedback Json?

  /// Set only for a leg originated as part of a parallel dial batch — null
  /// for every call placed the old single-line way.
  dialBatchId String?
  dialBatch   DialBatch? @relation(fields: [dialBatchId], references: [id], onDelete: SetNull)

  /// Live status of one leg within a dial batch — null for non-parallel
  /// calls. Drives the Dialer's "N linhas discando" queue rows.
  parallelLegStatus ParallelLegStatus?

  /// True for a losing leg the system hung up because another leg in the
  /// same batch already connected to a human first — never a BDR decision,
  /// never gets an outcome. Distinct from a normal outcome because it isn't
  /// a classification of a conversation; it's a system event. Counted
  /// separately for the abandonment-rate figure (Dial spec, 2026-08-25 —
  /// measured only in v1, no automatic cutoff yet).
  abandonedByParallelDial Boolean @default(false)

  tasks Task[]

  @@index([tenantId])
  @@index([personId])
  @@index([userId])
  @@index([dialBatchId])
  @@map("calls")
}

enum SignalCategory {
  PERSON
  COMPANY
  ENGAGEMENT
  AI_INTERPRETATION
}

model Signal {
  id String @id @default(uuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  category SignalCategory

  /// e.g. "job_change", "open_roles", "call_connected", "pain_detected" —
  /// kept as a string rather than a second enum since the Signal Engine's
  /// subtypes are expected to grow independently of the four categories.
  subtype String

  accountId String?
  account   Account? @relation(fields: [accountId], references: [id], onDelete: Cascade)

  personId String?
  person   Person? @relation(fields: [personId], references: [id], onDelete: Cascade)

  summary String

  /// URL for web-sourced signals, or a description like "Interactions do
  /// workspace Comitai" for internally-generated ones — every signal must
  /// be traceable back to where it came from.
  source String?

  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([tenantId])
  @@index([accountId])
  @@index([personId])
  @@map("signals")
}

enum ActivityType {
  ACCOUNT_CREATED
  PERSON_CREATED
  CALL_PLACED
  OUTCOME_RECORDED
  CADENCE_STEP_ADVANCED
  FIELD_EDITED
  EMAIL_SENT
  WHATSAPP_MESSAGE_SENT
  LINKEDIN_ACTION
}

/// Generic audit trail: every action taken on an Account/Person — call,
/// outcome, cadence move, field edit — must be written here before any
/// visual state changes on the frontend. Mirrors the login_events pattern
/// above, generalized to domain actions instead of auth events.
model Activity {
  id String @id @default(uuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  type ActivityType

  accountId String?
  account   Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  personId String?
  person   Person? @relation(fields: [personId], references: [id], onDelete: SetNull)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  payload Json?

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([accountId])
  @@index([personId])
  @@index([userId])
  @@map("activities")
}

enum TaskChannel {
  CALL
  WHATSAPP
  EMAIL
  LINKEDIN
}

/// Created automatically when a Dialer call is classified "Solicitou
/// retorno" — surfaces on the Overview page's task list, per the Dial spec.
model Task {
  id String @id @default(uuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  personId String
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  /// The call that generated this task, when there was one — kept even if
  /// the call is later deleted (shouldn't happen, but the task shouldn't
  /// vanish with it).
  sourceCallId String?
  sourceCall   Call?   @relation(fields: [sourceCallId], references: [id], onDelete: SetNull)

  channel TaskChannel
  dueAt   DateTime

  /// "Resumo da task via IA" — filled asynchronously after creation, null
  /// until the summary is generated.
  summary String?

  completedAt DateTime?

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([personId])
  @@index([accountId])
  @@map("tasks")
}

/// Global "não discar mais para esse número" list — deliberately NOT scoped
/// by tenant, unlike every other table in this schema. This is a DNC/
/// compliance control, not commercial data: a number marked here is
/// suppressed for every tenant, not just the one that marked it. See the
/// Dial spec (founder, 2026-08-24) for why this is an intentional exception
/// to the multi-tenant isolation rule — don't "fix" this in a future
/// isolation pass without re-reading that decision.
model SuppressedNumber {
  id          String @id @default(uuid())
  phoneNumber String @unique

  reason String?

  /// Informational only, not a relation — which tenant first suppressed
  /// this number doesn't gate anything, since the suppression is global.
  suppressedByTenantId String?

  createdAt DateTime @default(now())

  @@map("suppressed_numbers")
}

/// Cached AI research for an Account (company overview, role importance/
/// indicators, call script, objections, battlecards) — generated once on
/// first connected call and reused on every subsequent connection/callback
/// for that Account, per the Dial spec's "pesquisa profunda só pós-conexão,
/// nunca regenerada à toa" rule. Cached per (account, clientCompany), not
/// per account alone — the same prospect account can be worked by cadences
/// selling different client companies' products, and each needs its own
/// framing (2026-08-25). clientCompanyId is nullable only so pre-existing
/// rows from before this feature don't need a backfill guess; new rows
/// always carry one, since the Dialer no longer starts a cadence without
/// a client company set.
model AccountResearch {
  id String @id @default(uuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  clientCompanyId String?
  clientCompany   ClientCompany? @relation(fields: [clientCompanyId], references: [id], onDelete: SetNull)

  companyOverview String
  roleImportance  String
  roleIndicators  String
  callScript      String

  /// Array of { objection: string; response: string }.
  objections Json

  /// Array of up to 3 { competitor: string; theirStrength: string; ourEdge: string }.
  battlecards Json

  generatedAt DateTime @default(now())

  @@unique([accountId, clientCompanyId])
  @@index([tenantId])
  @@index([clientCompanyId])
  @@map("account_research")
}

enum GoalPeriod {
  WEEKLY
  MONTHLY
  QUARTERLY
}

/// One row per (user, period granularity) — a standing target the BDR
/// keeps editing in place, not a new row every week/month. `period` exists
/// from this first migration even though Workspace's UI only exposes
/// WEEKLY today, per the Dial spec's explicit instruction not to have to
/// remodel this later. Workspace (seção 8) writes here; KPI Targets
/// (seção 6) only reads.
model Goal {
  id String @id @default(uuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  period GoalPeriod

  callsTarget               Int @default(0)
  conversationsTarget       Int @default(0)
  dialingMinutesTarget      Int @default(0)
  conversationMinutesTarget Int @default(0)
  connectedCallsTarget      Int @default(0)

  /// Who last wrote this goal, in role terms — enforces "gestor tem
  /// prioridade em caso de conflito" (Dial spec, seção 8): once an ADMIN
  /// sets a goal, the owning BDR can no longer silently overwrite it via
  /// self-service; only another ADMIN write can change it further. This
  /// specific enforcement mechanic isn't spelled out in the spec beyond
  /// that one sentence — implemented this way as the most direct reading
  /// of "gestor tem prioridade".
  setByRole Role @default(MEMBER)

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([userId, period])
  @@index([tenantId])
  @@map("goals")
}
