NODE_ENV=development
PORT=3001

DATABASE_URL="postgresql://comitai:comitai_dev_password@localhost:5433/comitai?schema=public"

# Generate real random secrets per environment: `openssl rand -base64 64`
# Never reuse the access and refresh secrets, never commit real values.
JWT_ACCESS_SECRET="replace-me"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_SECRET="replace-me"
JWT_REFRESH_TTL="30d"

CORS_ORIGINS="http://localhost:3000"

REFRESH_COOKIE_NAME="comitai_rt"

# Optional. Overrides the refresh cookie's Secure flag, which otherwise
# follows NODE_ENV. Set to "false" only for a production deploy still
# served over plain HTTP (no domain/HTTPS yet) — browsers silently drop
# Secure cookies on non-HTTPS origins. Unset (or "true") once HTTPS is live.
# COOKIE_SECURE="false"

# Twilio Console → Account → API keys & tokens.
TWILIO_ACCOUNT_SID="replace-me"
TWILIO_AUTH_TOKEN="replace-me"
# E.164 format, the number calls are placed from (test calls, and the
# caller ID <Dial> uses for the Dialer).
TWILIO_PHONE_NUMBER="+15556667777"

# Twilio Console → Account → API keys & tokens → Create API key (Standard).
# Distinct from the Account SID/Auth Token above — used only to sign the
# short-lived browser softphone Access Tokens (Voice SDK).
TWILIO_API_KEY_SID="replace-me"
TWILIO_API_KEY_SECRET="replace-me"

# Twilio Console → Voice → TwiML → TwiML Apps → Create new TwiML App, with
# Voice "Request URL" set to `${PUBLIC_API_URL}/v1/calls/voice` (HTTP POST).
TWILIO_TWIML_APP_SID="replace-me"

# This API's own public base URL — must exactly match what's registered as
# the TwiML App's Voice Request URL, since /calls/voice re-derives it to
# verify Twilio's X-Twilio-Signature.
PUBLIC_API_URL="https://dev.api.comitai.app"
