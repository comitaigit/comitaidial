{
  "manifest_version": 3,
  "name": "Comitai — LinkedIn Sync",
  "version": "0.1.0",
  "description": "Verifica cargo e empresa no LinkedIn e sincroniza com o Comitai Dialer.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Comitai"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "http://localhost:3001/*",
    "https://*.comitai.app/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/in/*"],
      "js": ["content-script.js"],
      "run_at": "document_idle"
    }
  ]
}
